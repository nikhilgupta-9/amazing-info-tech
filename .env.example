# Copy this file to .env and fill in real values. Never commit .env itself.

# Local database (XAMPP default)
DB_HOST=localhost
DB_NAME=amazing_db
DB_USER=root
DB_PASS=

# Production database
DB_HOST_PROD=localhost
DB_NAME_PROD=
DB_USER_PROD=
DB_PASS_PROD=

# Site URLsgiy
SITE_URL_LOCAL=http://localhost/amazing/
SITE_URL_PROD=https://example.com/

# AES encryption used by ww_encryptor()/ww_decryptor()
ENCRYPTION_KEY=
ENCRYPTION_IV_SEED=

# PhonePe payment gateway
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_MERCHANT_ID_UAT=AMAZINGUAT
PHONEPE_SALT_KEY_UAT=

# Notification emails
CAREER_HR_EMAIL=
CAREER_SUPPORT_EMAIL=
